# GitHub App ID (shown on the app's "General" page, or via GET /app)
GITHUB_APP_ID=

# Private key: either a path to the .pem file, or the PEM contents inline
# (literal \n are accepted for single-line paste, e.g. from a secret store)
GITHUB_APP_PRIVATE_KEY=./private-key.pem

# Optional. If omitted the tool lists installations and uses the first one.
GITHUB_INSTALLATION_ID=

# github.com (default) or your GHE host, e.g. github.acme.com
GITHUB_HOST=

# Optional REST API version (default: the latest GitHub API version, 2026-03-10).
# Set this if your GHES only supports an older version such as 2022-11-28.
GITHUB_API_VERSION=

# Optional request timeout in milliseconds (default 15000)
GITHUB_TIMEOUT_MS=
